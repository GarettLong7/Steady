<%- include('partials/layout') %>
<section class="intro check-in-intro">
  <div class="check-in-header">
    <div><h1><%= day === today ? 'Today' : 'Daily check-in' %></h1>
      <p class="eyebrow"><time datetime="<%= day %>"><%= dateLabel(day) %></time></p></div>
    <a class="button" href="/notes/new">+ New Note</a>
  </div>
  <%- include('partials/date-navigation', { showTodayShortcut: day !== today }) %>
</section>
<div class="dashboard-grid check-in-grid">
  <%- include('partials/tracker', { daily, showCompleteNote: false, heading: day === today ? "Today's habits" : 'Daily habits' }) %>
  <section class="panel check-in-reflection" aria-labelledby="reflection-heading">
    <%- include('partials/mood', { daily }) %>
    <div class="section-heading">
      <h2 id="reflection-heading">Quick reflection</h2>
    </div>
    <p class="notice" data-journal-rollover role="status" hidden>This reflection keeps its date. <a href="/">Open today’s check-in</a></p>
    <form method="post" class="form-stack" data-editor data-follows-today="<%= followsToday %>"
      data-endpoint="/api/daily/<%= day %>" data-day="<%= day %>" data-version="<%= reflection.version %>"
      data-generation="<%= generation %>">
      <textarea class="field quick-reflection" name="body" rows="5" aria-labelledby="reflection-heading"
        placeholder="What happened today? How are you feeling? Anything worth remembering?">
<%= reflection.body %></textarea>
      <div class="actions editor-actions">
        <button class="button" type="button" data-reload-entry hidden>Reload latest</button>
        <button class="button compact" type="button" data-retry hidden>Retry</button>
        <span class="status" role="status" data-status><%= reflection.version ? 'Saved' : 'Changes save automatically' %></span>
      </div>
    </form>
  </section>
</div>
<div class="check-in-footer">
  <p><%= encouragement %></p>
  <p class="check-in-streak">Current streak <strong data-streak><%= stats.current %></strong> <span><%= stats.current === 1 ? 'day' : 'days' %></span></p>
</div>
<%- include('partials/end') %>

