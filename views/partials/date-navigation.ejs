<% const showToday = typeof showTodayShortcut === 'undefined' || showTodayShortcut; %>
<% if (dates.previous || dates.next || showToday) { %>
<nav class="date-navigation actions" aria-label="Browse dates">
  <% if (dates.previous) { %><a class="button" href="<%= dates.previous %>">Previous day</a><% } %>
  <% if (showToday) { %><a class="button" href="<%= dates.today %>">Today</a><% } %>
  <% if (dates.next) { %><a class="button" href="<%= dates.next %>">Next day</a><% } %>
</nav>
<% } %>
