<div class="password-field" data-password-field>
  <label for="<%= id %>"><%= label %></label>
  <div class="password-input">
    <input class="field" type="password" id="<%= id %>" name="<%= name %>" required maxlength="256"
      <% if (typeof minLength !== 'undefined' && minLength) { %>minlength="<%= minLength %>"<% } %>
      <% if (typeof describedBy !== 'undefined') { %>aria-describedby="<%= describedBy %>"<% } %>
      autocomplete="<%= autocomplete %>" spellcheck="false" autocapitalize="none" autocorrect="off">
    <button class="password-toggle" type="button" data-password-toggle aria-controls="<%= id %>"
      data-password-label="<%= label.toLowerCase() %>" aria-label="Show <%= label.toLowerCase() %>" hidden>
      <svg class="password-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M2 12s3.7-6 10-6 10 6 10 6-3.7 6-10 6S2 12 2 12Z"/>
        <circle cx="12" cy="12" r="2.5"/>
      </svg>
      <svg class="password-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 3l18 18M9.8 6.2A11 11 0 0 1 12 6c6.3 0 10 6 10 6a15.4 15.4 0 0 1-3 3.3M6.1 7.8A15.6 15.6 0 0 0 2 12s3.7 6 10 6a11 11 0 0 0 4-.8"/>
      </svg>
    </button>
  </div>
</div>

